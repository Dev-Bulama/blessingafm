# ---------- App ----------
NODE_ENV=production
PORT=3000
# Public URL of the site, no trailing slash (used in emails, sitemap, Stripe redirects)
APP_URL=https://www.example.com
# Long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string
# Set to 1 when the site is served over HTTPS (always in production)
COOKIE_SECURE=1

# ---------- MySQL (hPanel > Databases) ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=u123456789_blessing
DB_USER=u123456789_blessing
DB_PASSWORD=change-me
# Total connections used = DB_POOL_MAX (app) + 2 (session store). Keep this at 3 or less.
DB_POOL_MAX=3

# ---------- Database setup without a terminal (optional) ----------
# 1 = apply pending migrations every time the app starts (safe to leave on)
AUTO_MIGRATE=0
# 1 = run the seeds at start-up. Use for the FIRST deploy only, then set back to 0 and redeploy.
AUTO_SEED=0

# ---------- First admin user (used only by `npm run seed`) ----------
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=change-me-min-10-chars
ADMIN_FIRST_NAME=Store
ADMIN_LAST_NAME=Admin

# ---------- Email (hPanel mailbox SMTP) ----------
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
# 1 for port 465 (SSL), 0 for port 587 (STARTTLS)
SMTP_SECURE=1
SMTP_USER=orders@example.com
SMTP_PASSWORD=change-me
MAIL_FROM="Blessing African Market <orders@example.com>"
# Local development only: set to "log" to write emails to logs/app.log instead of sending them.
MAIL_TRANSPORT=smtp

# ---------- Stripe ----------
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ---------- PayPal (optional) ----------
# REST app credentials from developer.paypal.com > Apps & Credentials. Leave empty to hide PayPal at checkout.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox while testing, live when you go live
PAYPAL_MODE=sandbox

# ---------- Uploads & logs ----------
# Absolute path OUTSIDE the deployed code folder is recommended so redeploys never wipe images,
# e.g. /home/u123456789/blessing-data/uploads . Defaults to ./uploads
UPLOAD_DIR=
# Defaults to ./logs
LOG_DIR=

# ---------- Scheduled tasks ----------
# Secret for the cron URL: https://<domain>/cron/cleanup?token=<CRON_TOKEN>
CRON_TOKEN=change-me-to-a-random-token
