{
  "name": "blessing-african-market",
  "version": "1.0.0",
  "description": "Blessing African Market & Beauty Store - e-commerce store (Express, EJS, MySQL)",
  "private": true,
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "dev:css": "tailwindcss -i ./src/styles/app.css -o ./src/public/css/app.css --watch",
    "build": "tailwindcss -i ./src/styles/app.css -o ./src/public/css/app.css --minify",
    "migrate": "node scripts/setup-db.js migrate",
    "migrate:rollback": "knex migrate:rollback",
    "seed": "node scripts/setup-db.js seed",
    "test": "node --test tests/*.test.js",
    "migrate:raw": "knex migrate:latest"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "dotenv": "^18.0.10",
    "ejs": "^7.0.2",
    "express": "^4.22.3",
    "express-ejs-layouts": "^2.5.1",
    "express-mysql-session": "^3.0.3",
    "express-rate-limit": "^8.7.4",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "knex": "^3.3.0",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.5.0",
    "rotating-file-stream": "^4.0.0",
    "sanitize-html": "^2.18.1",
    "stripe": "^23.1.0",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.19"
  },
  "overrides": {
    "express-mysql-session": {
      "mysql2": "$mysql2"
    }
  }
}
