<h1 style="font-size:22px;margin:0 0 12px;">Your pickup is <%= isToday ? 'today' : 'tomorrow' %></h1>
<p style="margin:0 0 12px;">Hi <%= order.first_name %>, a quick reminder about order <strong><%= order.order_number %></strong>.</p>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="font-size:15px;background:#FFD400;border:2px solid #111111;margin:12px 0;"><tr><td style="padding:14px;">
  <strong><%= dates.formatYmd(order.pickup_date, true) %></strong><br><strong><%= order.pickup_slot_label %></strong><br><br>
  <%= settings.store_address_line1 %>, <%= settings.store_city %>, <%= settings.store_province %>
</td></tr></table>
<p style="margin:0 0 12px;"><%= order.payment_status === 'paid' ? 'Your order is paid. Just bring your order number.' : `Please bring your order number. Amount to pay in store: ${money(order.total_cents)}.` %></p>
<% if (order.status !== 'ready_for_pickup') { %><p style="margin:0 0 12px;font-size:13px;color:#555555;">We will email you as soon as it is packed and ready.</p><% } %>
<p style="margin:20px 0 0;"><a href="<%= orderUrl %>" style="display:inline-block;background:#D81E1E;color:#ffffff;font-weight:bold;text-decoration:none;padding:12px 20px;border:2px solid #111111;">View your order</a></p>
<p style="margin:16px 0 0;font-size:13px;color:#555555;">Need to change the time? Reply to this email<% if (settings.store_phone) { %> or call <%= settings.store_phone %><% } %>.</p>
