<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= subject %></title>
</head>
<body style="margin:0;padding:0;background:#f3f3f3;font-family:Arial,Helvetica,sans-serif;color:#111111;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f3f3f3;">
<tr><td align="center" style="padding:24px 12px;">
  <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="max-width:600px;width:100%;background:#ffffff;border:2px solid #111111;">
    <tr><td style="background:#D81E1E;padding:18px 24px;">
      <% if (settings.logo_path) { %><img src="<%= appUrl %>/uploads/<%= settings.logo_path %>" alt="<%= settings.store_name %>" height="48" style="height:48px;width:auto;display:block;background:#ffffff;padding:4px;">
      <% } else { %><span style="font-family:Impact,'Arial Narrow',Arial,sans-serif;font-size:26px;letter-spacing:1px;color:#ffffff;text-transform:uppercase;"><%= settings.store_name %></span><% } %>
    </td></tr>
    <tr><td style="height:6px;background:#FFD400;font-size:0;line-height:0;">&nbsp;</td></tr>
    <tr><td style="padding:28px 24px;font-size:15px;line-height:1.55;">
      <%- body %>
    </td></tr>
    <tr><td style="background:#111111;color:#ffffff;padding:18px 24px;font-size:12px;line-height:1.6;">
      <strong><%= settings.store_name %></strong><br>
      <%= settings.store_address_line1 %>, <%= settings.store_city %>, <%= settings.store_province %><br>
      <% if (settings.store_phone) { %><%= settings.store_phone %> &middot; <% } %><a href="<%= appUrl %>" style="color:#FFD400;"><%= appUrl.replace(/^https?:\/\//, '') %></a>
    </td></tr>
  </table>
</td></tr>
</table>
</body>
</html>
