<h1 style="font-size:22px;margin:0 0 12px;">How was your order, <%= user.first_name %>?</h1>
<p style="margin:0 0 12px;">Thank you for shopping with us (order <%= order.order_number %>). Your honest review helps other customers choose, and it helps us stock what you like. It takes less than a minute.</p>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;font-size:14px;margin:12px 0;">
  <% products.forEach((p) => { %><tr><td style="border-bottom:1px solid #dddddd;padding:10px 0;"><strong><%= p.name %></strong></td><td align="right" style="border-bottom:1px solid #dddddd;padding:10px 0;"><a href="<%= appUrl %>/p/<%= p.slug %>#reviews" style="color:#D81E1E;font-weight:bold;">Write a review</a></td></tr><% }) %>
</table>
<p style="margin:16px 0 0;font-size:12px;color:#555555;">You will be asked to sign in first. <a href="<%= unsubscribe %>" style="color:#555555;">Stop these emails</a>.</p>
