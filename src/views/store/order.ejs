<% const q = token ? `?t=${token}` : ''; const unpaidCard = order.payment_method === 'stripe' && order.status === 'pending' && order.payment_status === 'unpaid'; %>
<div class="container-site max-w-4xl py-8">
  <% if (unpaidCard && paymentCancelled) { %>
    <h1 class="h-display text-4xl sm:text-5xl">Payment not completed</h1>
    <p class="alert-error mt-4" role="alert">Your card was not charged. Your items are being held for a short time - complete the payment to confirm your order.</p>
  <% } else if (unpaidCard) { %>
    <h1 class="h-display text-4xl sm:text-5xl">Confirming your payment&hellip;</h1>
    <p class="alert-info mt-4" role="status" <%= justPaid ? 'data-refresh-until-paid' : '' %>><%= justPaid ? 'Thank you! We are waiting for confirmation from the payment processor. This page will update automatically in a few seconds.' : 'This order has not been paid yet.' %></p>
  <% } else if (order.status === 'cancelled') { %>
    <h1 class="h-display text-4xl sm:text-5xl">Order cancelled</h1>
  <% } else { %>
    <h1 class="h-display text-4xl sm:text-5xl">Thank you, <%= order.first_name %>!</h1>
    <p class="mt-2 text-lg">Your order has been received. A confirmation has been sent to <strong><%= order.email %></strong>.</p>
  <% } %>

  <p class="mt-4 flex flex-wrap items-center gap-3 text-sm">
    <span class="rounded bg-brand-black px-3 py-1 font-bold text-white">Order <%= order.order_number %></span>
    <span>Placed <%= dates.formatDateTime(order.created_at) %></span>
    <span class="status status-<%= order.status %>"><%= STATUS_LABELS[order.status] %></span>
  </p>

  <% if (unpaidCard && stripeAvailable) { %>
    <form action="/order/<%= order.order_number %>/pay<%= q %>" method="post" class="mt-5">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="btn-primary shadow-hard-sm">Pay <%= money(order.total_cents) %> now</button>
    </form>
  <% } %>

  <% if (order.payment_method === 'etransfer' && order.payment_status === 'unpaid' && order.status === 'awaiting_payment') { %>
    <section class="mt-6 rounded-xl border-4 border-brand-black bg-brand-yellow p-5" aria-labelledby="etransfer-title">
      <h2 id="etransfer-title" class="h-display text-2xl">Pay by Interac e-Transfer</h2>
      <dl class="mt-3 grid gap-2 text-sm sm:grid-cols-3">
        <div><dt class="font-bold uppercase">Send to</dt><dd class="break-all text-base font-bold"><%= settings.etransfer_email %></dd></div>
        <div><dt class="font-bold uppercase">Amount</dt><dd class="text-base font-bold"><%= money(order.total_cents) %></dd></div>
        <div><dt class="font-bold uppercase">Message</dt><dd class="text-base font-bold"><%= order.order_number %></dd></div>
      </dl>
      <p class="mt-3 text-sm"><%= settings.etransfer_instructions %></p>
    </section>
  <% } %>
  <% if (order.payment_method === 'in_store' && order.payment_status === 'unpaid' && order.status !== 'cancelled') { %>
    <p class="alert-info mt-6">Pay <strong><%= money(order.total_cents) %></strong> in store when you collect your order. Please bring your order number.</p>
  <% } %>

  <section class="mt-6" aria-label="Order status"><%- include('../partials/order-tracker', { order, steps }) %></section>
  <section class="mt-6" aria-label="Fulfilment and payment"><%- include('../partials/order-fulfilment', { order }) %></section>
  <section class="mt-6" aria-label="Order items"><%- include('../partials/order-summary', { order }) %></section>

  <div class="no-print mt-8 flex flex-wrap gap-3">
    <a href="/order/<%= order.order_number %>/invoice<%= q %>" class="btn-outline" target="_blank">Print invoice</a>
    <a href="/shop" class="btn-dark">Continue shopping</a>
    <% if (!currentUser) { %><a href="/account/register" class="btn-yellow">Create an account to track orders</a><% } %>
  </div>
</div>
