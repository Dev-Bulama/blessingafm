<div class="container-site py-6">
  <%- include('../partials/breadcrumbs', { breadcrumbs, lastIsCurrent: true }) %>
  <div class="mt-3 flex flex-wrap items-end justify-between gap-3">
    <div>
      <h1 class="h-display text-4xl sm:text-5xl"><%= heading %></h1>
      <% if (intro) { %><p class="mt-2 max-w-3xl text-neutral-800"><%= intro %></p><% } %>
    </div>
    <p class="text-sm font-semibold text-neutral-700" role="status"><%= result.total %> product<%= result.total === 1 ? '' : 's' %></p>
  </div>

  <% const hasFilters = subcategories.length || brands.length || result.total > 0 || activeFilterCount > 0; %>
  <div class="mt-6 grid gap-6 lg:grid-cols-[260px_1fr]">
    <%# ---------- Filters ---------- %>
    <aside aria-label="Filters">
      <details class="rounded-xl border border-neutral-300 p-4 lg:border-0 lg:p-0" open data-filter-details data-active="<%= activeFilterCount %>">
        <summary class="flex min-h-[44px] items-center justify-between font-bold uppercase tracking-wide lg:hidden">Filter &amp; sort<% if (activeFilterCount) { %> (<%= activeFilterCount %>)<% } %><%- include('../partials/icons', { icon: 'chevron', cls: 'h-5 w-5' }) %></summary>
        <form method="get" action="" class="space-y-5 pt-4 lg:pt-0" data-filter-form>
          <% if (searchQuery) { %><input type="hidden" name="q" value="<%= searchQuery %>"><% } %>
          <% if (filter.deal) { %><input type="hidden" name="deal" value="1"><% } %>
          <div>
            <label for="sort" class="label uppercase tracking-wide">Sort by</label>
            <select id="sort" name="sort" class="input" data-auto-submit>
              <% sortOptions.forEach(([v, l]) => { %><option value="<%= v %>" <%= sort === v ? 'selected' : '' %>><%= l %></option><% }) %>
            </select>
          </div>
          <% if (subcategories.length) { %>
            <fieldset>
              <legend class="label uppercase tracking-wide">Category</legend>
              <ul class="max-h-64 space-y-1 overflow-y-auto pr-1">
                <% subcategories.forEach((c) => { %>
                  <li><label class="flex min-h-[36px] items-center gap-2 text-sm"><input type="checkbox" class="checkbox" name="cat" value="<%= c.id %>" <%= filter.catIds.includes(c.id) ? 'checked' : '' %>><%= c.name %></label></li>
                <% }) %>
              </ul>
            </fieldset>
          <% } %>
          <% if (brands.length) { %>
            <fieldset>
              <legend class="label uppercase tracking-wide">Brand</legend>
              <ul class="max-h-64 space-y-1 overflow-y-auto pr-1">
                <% brands.forEach((b) => { %>
                  <li><label class="flex min-h-[36px] items-center gap-2 text-sm"><input type="checkbox" class="checkbox" name="brand" value="<%= b.id %>" <%= filter.brandIds.includes(b.id) ? 'checked' : '' %>><%= b.name %> <span class="text-neutral-600">(<%= b.count %>)</span></label></li>
                <% }) %>
              </ul>
            </fieldset>
          <% } %>
          <fieldset>
            <legend class="label uppercase tracking-wide">Price (CAD)</legend>
            <div class="flex items-center gap-2">
              <label class="sr-only" for="min">Minimum price</label>
              <input id="min" type="text" inputmode="decimal" name="min" value="<%= filter.minPrice !== undefined ? centsToInput(filter.minPrice) : '' %>" placeholder="Min" class="input">
              <span aria-hidden="true">&ndash;</span>
              <label class="sr-only" for="max">Maximum price</label>
              <input id="max" type="text" inputmode="decimal" name="max" value="<%= filter.maxPrice !== undefined ? centsToInput(filter.maxPrice) : '' %>" placeholder="Max" class="input">
            </div>
          </fieldset>
          <fieldset>
            <legend class="label uppercase tracking-wide">Availability</legend>
            <label class="flex min-h-[36px] items-center gap-2 text-sm"><input type="checkbox" class="checkbox" name="stock" value="1" <%= filter.inStock ? 'checked' : '' %>>In stock only</label>
            <label class="flex min-h-[36px] items-center gap-2 text-sm"><input type="checkbox" class="checkbox" name="sale" value="1" <%= filter.onSale ? 'checked' : '' %>>On sale</label>
          </fieldset>
          <div class="flex gap-2">
            <button type="submit" class="btn-primary flex-1">Apply</button>
            <% if (activeFilterCount) { %><a href="<%= qs({}, { q: searchQuery || null, deal: filter.deal ? 1 : null }) %>" class="btn-outline">Clear</a><% } %>
          </div>
        </form>
      </details>
    </aside>

    <%# ---------- Results ---------- %>
    <section aria-label="Products">
      <% if (!result.rows.length) { %>
        <div class="panel text-center">
          <p class="text-lg font-bold"><%= searchQuery ? `No products found for "${searchQuery}".` : 'No products match these filters.' %></p>
          <p class="mt-1 text-neutral-700">Try a different search or clear the filters. Looking for something specific? <a href="/contact" class="link">Ask us</a> and we will try to get it in.</p>
          <a href="/shop" class="btn-primary mt-4">Browse all products</a>
        </div>
      <% } else { %>
        <ul class="grid grid-cols-2 gap-3 sm:gap-4 md:grid-cols-3 xl:grid-cols-4">
          <% result.rows.forEach((p) => { %><li><%- include('../partials/product-card', { p }) %></li><% }) %>
        </ul>
        <%- include('../partials/pagination', { page: result.page, pages: result.pages, hrefFor: (n) => qs(query, { page: n === 1 ? null : n }) }) %>
      <% } %>
    </section>
  </div>
</div>
