<div class="container-site py-8">
  <h1 class="h-display text-4xl sm:text-5xl"><%= page ? page.title : 'Contact us' %></h1>
  <div class="mt-6 grid gap-8 lg:grid-cols-2">
    <section aria-labelledby="form-title">
      <% if (page && page.body_html) { %><div class="prose-store"><%- page.body_html %></div><% } %>
      <h2 id="form-title" class="sr-only">Send us a message</h2>
      <form action="/contact" method="post" class="mt-4 space-y-4">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="grid gap-4 sm:grid-cols-2">
          <%- include('../partials/field', { name: 'name', label: 'Your name', value: currentUser ? `${currentUser.first_name} ${currentUser.last_name}` : '', required: true, autocomplete: 'name' }) %>
          <%- include('../partials/field', { name: 'email', label: 'Email', type: 'email', value: currentUser && currentUser.email, required: true, autocomplete: 'email' }) %>
          <%- include('../partials/field', { name: 'phone', label: 'Phone (optional)', type: 'tel', autocomplete: 'tel' }) %>
          <%- include('../partials/field', { name: 'subject', label: 'Subject (optional)' }) %>
        </div>
        <%- include('../partials/field', { name: 'message', label: 'Message', type: 'textarea', rows: 6, required: true, attrs: 'maxlength="5000"' }) %>
        <div class="hidden" aria-hidden="true"><label>Leave this field empty <input type="text" name="website" tabindex="-1" autocomplete="off"></label></div>
        <button type="submit" class="btn-primary">Send message</button>
      </form>
    </section>
    <section aria-labelledby="visit-title" class="space-y-5">
      <div class="rounded-xl border-4 border-brand-black bg-brand-cream p-5">
        <h2 id="visit-title" class="h-display text-2xl">Visit or call</h2>
        <div class="mt-3"><%- include('../partials/store-info') %></div>
      </div>
      <iframe title="Map showing <%= settings.store_name %>" loading="lazy" class="h-72 w-full rounded-xl border-4 border-brand-black"
        src="https://www.google.com/maps?q=<%= encodeURIComponent(`${settings.store_address_line1}, ${settings.store_city}, ${settings.store_province}, Canada`) %>&output=embed"></iframe>
    </section>
  </div>
</div>
