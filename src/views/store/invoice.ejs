<%# Printable invoice (mode = 'invoice') or packing slip (mode = 'packing'). %>
<% const packing = mode === 'packing'; %>
<header class="flex flex-wrap items-start justify-between gap-6 border-b-4 border-brand-black pb-4">
  <div>
    <%- include('../partials/logo') %>
    <p class="mt-3 text-sm"><%= settings.store_address_line1 %>, <%= settings.store_city %>, <%= settings.store_province %><% if (settings.store_postal_code && !settings.store_postal_code.includes('PLACEHOLDER')) { %> <%= settings.store_postal_code %><% } %><br>
      <%= settings.store_phone %> &middot; <%= settings.store_email %></p>
  </div>
  <div class="text-right">
    <h1 class="h-display text-4xl"><%= packing ? 'Packing slip' : 'Invoice' %></h1>
    <p class="mt-1 text-sm"><strong><%= order.order_number %></strong><br>Date: <%= dates.formatDate(order.created_at) %><br>
      <% if (!packing) { %>Status: <%= order.payment_status === 'paid' ? 'PAID' : order.payment_status === 'refunded' ? 'REFUNDED' : 'UNPAID' %><% } else { %><%= FULFILMENT_LABELS[order.fulfilment_method] %><% } %></p>
  </div>
</header>

<section class="mt-5 grid grid-cols-2 gap-6 text-sm">
  <div>
    <h2 class="font-bold uppercase tracking-wide">Customer</h2>
    <p class="mt-1"><%= order.first_name %> <%= order.last_name %><br><%= order.email %><br><%= order.phone %></p>
  </div>
  <div>
    <h2 class="font-bold uppercase tracking-wide"><%= FULFILMENT_LABELS[order.fulfilment_method] %></h2>
    <% if (order.fulfilment_method === 'pickup') { %>
      <p class="mt-1"><%= dates.formatYmd(order.pickup_date, true) %><br><%= order.pickup_slot_label %></p>
    <% } else { %>
      <address class="mt-1 not-italic"><%= order.ship_name %><br><%= order.ship_line1 %><% if (order.ship_line2) { %><br><%= order.ship_line2 %><% } %><br><%= order.ship_city %>, <%= order.ship_province %> <%= order.ship_postal_code %></address>
      <% if (order.tracking_number) { %><p class="mt-1">Tracking: <%= order.tracking_carrier %> <%= order.tracking_number %></p><% } %>
    <% } %>
  </div>
</section>
<% if (order.customer_note) { %><p class="mt-4 rounded border border-neutral-400 p-3 text-sm"><strong>Customer note:</strong> <%= order.customer_note %></p><% } %>

<% if (packing) { %>
  <table class="table mt-6">
    <thead><tr><th scope="col" class="w-12">Packed</th><th scope="col">Item</th><th scope="col">SKU</th><th scope="col" class="text-right">Qty</th></tr></thead>
    <tbody>
      <% order.items.forEach((i) => { %>
        <tr><td><span class="inline-block h-5 w-5 border-2 border-brand-black" aria-hidden="true"></span></td>
          <td class="font-semibold"><%= i.name %><% if (i.variant_name) { %> (<%= i.variant_name %>)<% } %></td><td><%= i.sku %></td><td class="text-right text-lg font-bold"><%= i.qty %></td></tr>
      <% }) %>
    </tbody>
  </table>
  <p class="mt-4 text-sm">Total items: <strong><%= order.items.reduce((n, i) => n + i.qty, 0) %></strong> &middot; Payment: <%= PAYMENT_LABELS[order.payment_method] %> (<%= order.payment_status === 'paid' ? 'paid' : `collect ${money(order.total_cents)}` %>)</p>
<% } else { %>
  <div class="mt-6"><%- include('../partials/order-summary', { order }) %></div>
  <p class="mt-6 text-sm">Payment method: <%= PAYMENT_LABELS[order.payment_method] %><% if (order.paid_at) { %> &middot; Paid <%= dates.formatDate(order.paid_at) %><% } %></p>
  <p class="mt-1 text-xs text-neutral-700"><%= order.tax_label %> is charged at <%= bpsToPercentLabel(order.tax_rate_bps) %> on taxable items only. Items marked "zero-rated" are basic groceries with no <%= order.tax_label %>.</p>
<% } %>
<p class="mt-8 border-t border-neutral-300 pt-4 text-center text-sm">Thank you for shopping at <%= settings.store_name %>!</p>
