<div class="container-site max-w-md py-10">
  <h1 class="h-display text-4xl">Choose a new password</h1>
  <form action="/account/reset/<%= token %>" method="post" class="panel mt-6 space-y-4">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <%- include('../partials/field', { name: 'password', label: 'New password', type: 'password', required: true, autocomplete: 'new-password', help: 'At least 10 characters.', attrs: 'minlength="10"' }) %>
    <%- include('../partials/field', { name: 'password_confirm', label: 'Confirm new password', type: 'password', required: true, autocomplete: 'new-password' }) %>
    <button type="submit" class="btn-primary btn-block">Change password</button>
  </form>
</div>
