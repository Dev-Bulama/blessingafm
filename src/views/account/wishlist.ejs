<%- include('../partials/account-shell-top') %>
<h1 class="h-display text-4xl">My wishlist</h1>
<% if (!products.length) { %>
  <p class="panel mt-5 text-neutral-800">Your wishlist is empty. Tap "Add to wishlist" on any product to save it here.</p>
<% } else { %>
  <ul class="mt-5 grid grid-cols-2 gap-3 sm:gap-4 md:grid-cols-3">
    <% products.forEach((p) => { %>
      <li class="flex flex-col gap-2">
        <%- include('../partials/product-card', { p }) %>
        <form action="/wishlist/toggle/<%= p.id %>" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="back" value="wishlist">
          <button type="submit" class="text-sm font-semibold text-brand-red-dark underline">Remove<span class="sr-only"> <%= p.name %> from wishlist</span></button></form>
      </li>
    <% }) %>
  </ul>
<% } %>
<%- include('../partials/account-shell-bottom') %>
