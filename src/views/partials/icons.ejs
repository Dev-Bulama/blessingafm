<%# Inline SVG icons. Usage: include('../partials/icons', { icon: 'cart', cls: 'h-6 w-6' }) %>
<% const c = typeof cls !== 'undefined' ? cls : 'h-6 w-6'; %>
<svg class="<%= c %>" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
<% if (icon === 'cart') { %><circle cx="9" cy="20" r="1.5"/><circle cx="18" cy="20" r="1.5"/><path d="M2 3h3l2.6 12.4a1 1 0 0 0 1 .8h8.9a1 1 0 0 0 1-.8L20 8H6.2"/>
<% } else if (icon === 'user') { %><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>
<% } else if (icon === 'search') { %><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>
<% } else if (icon === 'menu') { %><path d="M3 6h18M3 12h18M3 18h18"/>
<% } else if (icon === 'close') { %><path d="M5 5l14 14M19 5 5 19"/>
<% } else if (icon === 'heart') { %><path d="M12 20.5s-7.5-4.6-9.3-9.2C1.4 7.9 3.500 4.500 7 4.500c2 0 3.700 1 5 2.800 1.300-1.800 3-2.800 5-2.800 3.500 0 5.600 3.400 4.300 6.800-1.800 4.600-9.300 9.200-9.300 9.200z"/>
<% } else if (icon === 'pin') { %><path d="M12 21s-7-6.100-7-11.500a7 7 0 0 1 14 0C19 14.900 12 21 12 21z"/><circle cx="12" cy="9.500" r="2.500"/>
<% } else if (icon === 'phone') { %><path d="M5 3h4l2 5-2.500 1.500a11 11 0 0 0 6 6L16 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 5a2 2 0 0 1 2-2z"/>
<% } else if (icon === 'mail') { %><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>
<% } else if (icon === 'clock') { %><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>
<% } else if (icon === 'truck') { %><path d="M1 5h13v11H1zM14 9h4l4 4v3h-8z"/><circle cx="6" cy="18.500" r="2"/><circle cx="18" cy="18.500" r="2"/>
<% } else if (icon === 'bag') { %><path d="M5 8h14l-1 13H6L5 8z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/>
<% } else if (icon === 'box') { %><path d="M21 8 12 3 3 8v8l9 5 9-5V8z"/><path d="M3 8l9 5 9-5M12 13v8"/>
<% } else if (icon === 'chevron') { %><path d="m6 9 6 6 6-6"/>
<% } else if (icon === 'trash') { %><path d="M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13"/>
<% } else if (icon === 'check') { %><path d="m5 12 5 5 9-10"/>
<% } else if (icon === 'snow') { %><path d="M12 2v20M4 6l16 12M20 6 4 18"/>
<% } %>
</svg>
