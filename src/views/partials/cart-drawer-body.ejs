<%# Contents of the slide-out cart. Rendered server-side and swapped in by store.js after each change. %>
<% if (!cart.items.length) { %>
  <div class="flex flex-1 flex-col items-center justify-center gap-4 p-8 text-center">
    <%- include('icons', { icon: 'cart', cls: 'h-14 w-14 text-neutral-400' }) %>
    <p class="text-lg font-bold">Your cart is empty</p>
    <a href="/shop" class="btn-primary">Start shopping</a>
  </div>
<% } else { %>
  <ul class="flex-1 divide-y divide-neutral-200 overflow-y-auto px-4" aria-label="Items in your cart">
    <% cart.items.forEach((item) => { %>
      <li class="flex gap-3 py-3">
        <img src="<%= upload(item.thumb) %>" alt="" width="72" height="72" loading="lazy" class="h-[72px] w-[72px] shrink-0 rounded border border-neutral-300 object-cover">
        <div class="min-w-0 flex-1">
          <a href="/p/<%= item.slug %>" class="block text-sm font-bold leading-snug no-underline hover:underline"><%= item.name %></a>
          <% if (item.variant_name) { %><p class="text-xs text-neutral-700"><%= item.variant_label || 'Option' %>: <%= item.variant_name %></p><% } %>
          <% if (item.problem) { %><p class="text-xs font-bold text-brand-red-dark"><%= item.problem %></p><% } %>
          <div class="mt-2 flex items-center justify-between gap-2">
            <form action="/cart/update" method="post" class="flex items-center" data-cart-form>
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="item_id" value="<%= item.item_id %>">
              <div class="flex items-center rounded-lg border-2 border-brand-black" data-stepper>
                <button type="button" class="h-9 w-9 text-lg font-bold" data-step="-1" aria-label="Decrease quantity of <%= item.name %>">&minus;</button>
                <input type="number" name="qty" value="<%= item.qty %>" min="0" max="<%= Math.max(item.stock, 1) %>" inputmode="numeric" class="h-9 w-10 border-x-2 border-brand-black text-center text-sm font-bold" aria-label="Quantity of <%= item.name %>" data-auto-submit>
                <button type="button" class="h-9 w-9 text-lg font-bold" data-step="1" aria-label="Increase quantity of <%= item.name %>">+</button>
              </div>
            </form>
            <span class="text-sm font-bold"><%= money(item.line_cents) %></span>
          </div>
        </div>
        <form action="/cart/remove" method="post" data-cart-form>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="item_id" value="<%= item.item_id %>">
          <button type="submit" class="rounded p-1 text-neutral-700 hover:text-brand-red" aria-label="Remove <%= item.name %> from cart"><%- include('icons', { icon: 'trash', cls: 'h-5 w-5' }) %></button>
        </form>
      </li>
    <% }) %>
  </ul>
  <div class="border-t-2 border-brand-black bg-brand-cream p-4">
    <dl class="space-y-1 text-sm">
      <div class="flex justify-between"><dt>Subtotal</dt><dd class="font-semibold"><%= money(quote.totals.subtotal_cents) %></dd></div>
      <% if (quote.totals.discount_cents) { %><div class="flex justify-between text-brand-green-dark"><dt>Discount (<%= quote.coupon.code %>)</dt><dd class="font-semibold">-<%= money(quote.totals.discount_cents) %></dd></div><% } %>
      <div class="flex justify-between"><dt><%= quote.tax_label %></dt><dd class="font-semibold"><%= money(quote.totals.tax_cents) %></dd></div>
      <div class="flex items-baseline justify-between pt-1"><dt class="font-bold uppercase">Estimated total</dt><dd class="font-display text-2xl tracking-wide"><%= money(quote.totals.total_cents) %></dd></div>
    </dl>
    <p class="mt-1 text-xs text-neutral-700">Delivery or shipping is calculated at checkout. Pickup is free.</p>
    <div class="mt-3 grid grid-cols-2 gap-2">
      <a href="/cart" class="btn-outline">View cart</a>
      <a href="/checkout" class="btn-primary">Checkout</a>
    </div>
  </div>
<% } %>
