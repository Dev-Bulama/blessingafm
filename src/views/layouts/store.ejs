<!DOCTYPE html>
<html lang="en-CA">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <% const _full = typeof fullTitle !== 'undefined' && fullTitle; const _title = title ? (_full ? title : `${title} | ${settings.store_name}`) : settings.store_name; const _desc = metaDescription || settings.meta_description; const _og = ogImage || `${appUrl}/assets/img/og-default.png`; %>
  <title><%= _title %></title>
  <meta name="description" content="<%= truncate(_desc, 300) %>">
  <% if (noindex) { %><meta name="robots" content="noindex, nofollow"><% } else { %><link rel="canonical" href="<%= canonical %>"><% } %>
  <meta property="og:site_name" content="<%= settings.store_name %>">
  <meta property="og:type" content="<%= typeof ogType !== 'undefined' ? ogType : 'website' %>">
  <meta property="og:title" content="<%= title || settings.store_name %>">
  <meta property="og:description" content="<%= truncate(_desc, 300) %>">
  <meta property="og:url" content="<%= canonical %>">
  <meta property="og:image" content="<%= _og %>">
  <meta property="og:locale" content="en_CA">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="theme-color" content="#D81E1E">
  <link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
  <link rel="preload" href="/assets/fonts/anton-400.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/inter-var.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="<%= asset('css/app.css') %>">
  <% jsonLdBlocks.forEach((block) => { %><script type="application/ld+json"><%- jsonLd(block) %></script>
  <% }) %>
</head>
<body class="flex min-h-screen flex-col" data-csrf="<%= csrfToken %>">
  <a href="#main" class="skip-link">Skip to main content</a>
  <%- include('../partials/header') %>
  <%- include('../partials/flash') %>
  <main id="main" class="flex-1" tabindex="-1">
    <%- body %>
  </main>
  <%- include('../partials/footer') %>

  <%# Slide-out cart %>
  <div class="drawer-backdrop" data-drawer-backdrop hidden></div>
  <aside id="cart-drawer" class="drawer" role="dialog" aria-modal="true" aria-labelledby="cart-drawer-title" aria-hidden="true" tabindex="-1">
    <div class="flex items-center justify-between border-b-2 border-brand-black bg-brand-yellow px-4 py-3">
      <h2 id="cart-drawer-title" class="h-display text-2xl">Your cart</h2>
      <button type="button" class="rounded p-2" data-drawer-close aria-label="Close cart"><%- include('../partials/icons', { icon: 'close' }) %></button>
    </div>
    <p class="hidden bg-brand-black px-4 py-2 text-sm font-semibold text-white" data-drawer-message role="status"></p>
    <div class="flex min-h-0 flex-1 flex-col" data-drawer-body>
      <p class="p-8 text-center text-neutral-700">Loading your cart&hellip;</p>
    </div>
  </aside>

  <% const _wa = digits(settings.store_whatsapp).replace('+', ''); if (_wa.length >= 10) { %>
    <a href="https://wa.me/<%= _wa %>?text=<%= encodeURIComponent(`Hello ${settings.store_name}!`) %>" target="_blank" rel="noopener noreferrer"
       class="no-print fixed bottom-4 right-4 z-30 flex h-14 w-14 items-center justify-center rounded-full border-2 border-brand-black bg-brand-green-dark text-white shadow-hard-sm hover:bg-green-900"
       aria-label="Chat with us on WhatsApp">
      <svg viewBox="0 0 32 32" class="h-8 w-8" fill="currentColor" aria-hidden="true"><path d="M16 3C8.800 3 3 8.800 3 16c0 2.300.600 4.500 1.700 6.400L3 29l6.800-1.700c1.900 1 4 1.600 6.200 1.600 7.200 0 13-5.800 13-13S23.200 3 16 3zm0 23.600c-2 0-3.900-.500-5.600-1.500l-.400-.200-4 1 1.100-3.900-.300-.400A10.500 10.500 0 0 1 5.400 16C5.400 10.100 10.100 5.400 16 5.400S26.600 10.100 26.600 16 21.900 26.600 16 26.600zm5.800-7.900c-.300-.200-1.900-.900-2.200-1-.300-.100-.500-.200-.700.200-.200.300-.800 1-1 1.200-.200.200-.400.200-.700.100-1.900-.900-3.100-1.700-4.300-3.800-.300-.600.300-.500.900-1.700.100-.200 0-.400 0-.500-.100-.200-.700-1.700-1-2.300-.200-.600-.500-.500-.700-.500h-.600c-.200 0-.500.100-.800.400-.300.300-1.100 1-1.100 2.500s1.100 2.900 1.200 3.100c.200.200 2.200 3.300 5.300 4.600 2 .800 2.700.900 3.700.800.600-.100 1.900-.800 2.100-1.500.300-.700.300-1.400.200-1.500-.100-.100-.300-.200-.600-.300z"/></svg>
    </a>
  <% } %>
  <script src="<%= asset('js/store.js') %>" defer></script>
  <% if (typeof pageScript !== 'undefined' && pageScript) { %><script src="<%= asset(`js/${pageScript}.js`) %>" defer></script><% } %>
</body>
</html>
