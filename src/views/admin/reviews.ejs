<%- include('../partials/admin-head', { heading: 'Reviews' }) %>
<nav aria-label="Review status" class="mb-4 flex flex-wrap gap-2">
  <% ['pending', 'approved', 'rejected'].forEach((s) => { %><a href="/admin/reviews?status=<%= s %>" class="<%= status === s ? 'btn-dark' : 'btn-outline' %> btn-sm" <%= status === s ? 'aria-current=page' : '' %>><%= s %> (<%= counts[s] || 0 %>)</a><% }) %>
</nav>
<% if (!rows.length) { %><p class="panel text-sm text-neutral-700">No <%= status %> reviews.</p><% } %>
<ul class="space-y-3">
  <% rows.forEach((r) => { %>
    <li class="panel">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm">
        <%- include('../partials/stars', { rating: r.rating, count: null }) %>
        <a href="/p/<%= r.product_slug %>" target="_blank" rel="noopener" class="font-bold"><%= r.product_name %></a>
        <span class="text-neutral-700">by <%= r.first_name %> <%= r.last_name %> (<%= r.email %>) &middot; <%= dates.formatDate(r.created_at) %></span>
      </div>
      <% if (r.title) { %><p class="mt-2 font-bold"><%= r.title %></p><% } %>
      <p class="mt-1 whitespace-pre-line text-sm"><%= r.body %></p>
      <div class="mt-3 flex flex-wrap gap-2">
        <% [['approve', 'Approve', 'btn-green', r.status !== 'approved'], ['reject', 'Reject', 'btn-outline', r.status !== 'rejected'], ['delete', 'Delete', 'btn-outline', true]].filter((a) => a[3]).forEach(([action, label, cls]) => { %>
          <form action="/admin/reviews/<%= r.id %>" method="post" <%- action === 'delete' ? 'data-confirm="Delete this review permanently?"' : '' %>>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="action" value="<%= action %>"><input type="hidden" name="status" value="<%= status %>">
            <button type="submit" class="<%= cls %> btn-sm"><%= label %></button></form>
        <% }) %>
      </div>
    </li>
  <% }) %>
</ul>
<%- include('../partials/admin-pager', { page, hasMore, hrefFor: (n) => qs(query, { page: n }) }) %>
