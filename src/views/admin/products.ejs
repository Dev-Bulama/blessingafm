<%- include('../partials/admin-head', { heading: `Products (${result.total})`, actions: [['/admin/products/new', 'Add product', 'btn-primary'], ['/admin/products/bulk', 'Bulk price & stock'], ['/admin/products/import', 'Import CSV'], ['/admin/products/export.csv', 'Export CSV']] }) %>
<form method="get" class="panel mb-4 grid gap-3 sm:grid-cols-4" role="search" aria-label="Filter products">
  <div class="sm:col-span-2"><label class="label" for="q">Search</label><input id="q" type="search" name="q" value="<%= q %>" placeholder="Name, brand, SKU or tag" class="input"></div>
  <div><label class="label" for="category">Category</label><select id="category" name="category" class="input"><option value="">All categories</option><% categories.forEach((c) => { %><option value="<%= c.id %>" <%= String(query.category) === String(c.id) ? 'selected' : '' %>><%= c.label %></option><% }) %></select></div>
  <div class="flex items-end gap-3"><label class="flex min-h-[44px] items-center gap-2 text-sm"><input type="checkbox" name="low" value="1" class="checkbox" <%= query.low === '1' ? 'checked' : '' %>>Low stock</label><button type="submit" class="btn-dark btn-sm">Filter</button></div>
</form>
<div class="panel overflow-x-auto">
  <% if (!result.rows.length) { %><p class="text-sm text-neutral-700">No products found.</p><% } else { %>
  <table class="table">
    <thead><tr><th scope="col"><span class="sr-only">Image</span></th><th scope="col">Product</th><th scope="col">SKU</th><th scope="col" class="text-right">Price</th><th scope="col" class="text-right">Stock</th><th scope="col">Flags</th><th scope="col"><span class="sr-only">Actions</span></th></tr></thead>
    <tbody>
      <% result.rows.forEach((p) => { %>
        <tr>
          <td><img src="<%= upload(p.thumb) %>" alt="" width="44" height="44" loading="lazy" class="h-11 w-11 rounded border border-neutral-300 object-cover"></td>
          <td><a href="/admin/products/<%= p.id %>/edit" class="font-bold"><%= p.name %></a><span class="block text-xs text-neutral-600"><%= p.brand_name || 'No brand' %><%= p.has_variants ? ' · has variants' : '' %></span></td>
          <td class="whitespace-nowrap"><%= p.sku %></td>
          <td class="whitespace-nowrap text-right"><%= p.has_variants ? 'from ' : '' %><%= money(p.price_cents) %></td>
          <td class="text-right font-bold <%= p.stock_qty <= p.low_stock_threshold ? 'text-brand-red-dark' : '' %>"><%= p.stock_qty %></td>
          <td><span class="flex flex-wrap gap-1">
            <% if (!p.is_active) { %><span class="badge-muted">Hidden</span><% } %><% if (p.is_featured) { %><span class="badge-yellow">Featured</span><% } %><% if (p.is_deal) { %><span class="badge-sale">Deal</span><% } %>
            <% if (!p.is_taxable) { %><span class="badge-green">No HST</span><% } %><% if (p.is_frozen) { %><span class="badge-blue">Frozen</span><% } %><% if (p.is_perishable) { %><span class="badge-muted">Perishable</span><% } %><% if (p.pickup_only) { %><span class="badge-dark">Pickup only</span><% } %>
          </span></td>
          <td class="whitespace-nowrap text-right"><a href="/admin/products/<%= p.id %>/edit" class="btn-outline btn-sm">Edit</a> <a href="/p/<%= p.slug %>" target="_blank" rel="noopener" class="btn-outline btn-sm">View</a></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  <% } %>
</div>
<%- include('../partials/pagination', { page: result.page, pages: result.pages, hrefFor: (n) => qs(query, { page: n }) }) %>
