<p class="mb-2 text-sm"><a href="/admin/customers" class="link">&larr; Customers</a></p>
<%- include('../partials/admin-head', { heading: `${customer.first_name} ${customer.last_name}` }) %>
<div class="grid gap-5 xl:grid-cols-[340px_1fr]">
  <div class="space-y-5">
    <section class="panel text-sm" aria-label="Account">
      <p><a href="mailto:<%= customer.email %>" class="link break-all"><%= customer.email %></a> <%= customer.email_verified_at ? '(confirmed)' : '(not confirmed)' %></p>
      <p class="mt-1"><%= customer.phone || 'No phone number' %></p>
      <p class="mt-1 text-neutral-700">Joined <%= dates.formatDate(customer.created_at) %><% if (customer.last_login_at) { %> &middot; last sign-in <%= dates.formatDate(customer.last_login_at) %><% } %></p>
      <p class="mt-3"><span class="<%= customer.is_disabled ? 'badge-muted' : 'badge-green' %>"><%= customer.is_disabled ? 'Account disabled' : 'Account active' %></span></p>
      <form action="/admin/customers/<%= customer.id %>/toggle" method="post" class="mt-3" data-confirm="<%= customer.is_disabled ? 'Re-enable this account?' : 'Disable this account? The customer will be signed out and unable to sign in.' %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="btn-outline btn-sm"><%= customer.is_disabled ? 'Re-enable account' : 'Disable account' %></button>
      </form>
    </section>
    <section class="panel text-sm" aria-labelledby="addr-title">
      <h2 id="addr-title" class="font-bold uppercase tracking-wide">Addresses</h2>
      <% if (!addresses.length) { %><p class="mt-2 text-neutral-700">No saved addresses.</p><% } %>
      <% addresses.forEach((a) => { %><address class="mt-3 not-italic"><%= a.full_name %><%= a.is_default ? ' (default)' : '' %><br><%= a.line1 %><% if (a.line2) { %>, <%= a.line2 %><% } %><br><%= a.city %>, <%= a.province %> <%= a.postal_code %></address><% }) %>
    </section>
  </div>
  <section class="panel overflow-x-auto" aria-labelledby="orders-title">
    <h2 id="orders-title" class="mb-3 font-bold uppercase tracking-wide">Order history (<%= orders.length %>)</h2>
    <%- include('../partials/admin-orders-table', { orders }) %>
  </section>
</div>
