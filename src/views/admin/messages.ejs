<%- include('../partials/admin-head', { heading: 'Contact messages' }) %>
<% if (!rows.length) { %><p class="panel text-sm text-neutral-700">No messages yet.</p><% } %>
<ul class="space-y-3">
  <% rows.forEach((m) => { %>
    <li class="panel <%= m.is_read ? '' : 'border-2 border-brand-black' %>">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <p class="text-sm"><% if (!m.is_read) { %><span class="badge-sale">New</span> <% } %><strong><%= m.name %></strong> &middot; <a href="mailto:<%= m.email %>" class="link"><%= m.email %></a><% if (m.phone) { %> &middot; <%= m.phone %><% } %></p>
        <p class="text-xs text-neutral-600"><%= dates.formatDateTime(m.created_at) %></p>
      </div>
      <% if (m.subject) { %><p class="mt-2 font-bold"><%= m.subject %></p><% } %>
      <p class="mt-1 whitespace-pre-line text-sm"><%= m.message %></p>
      <div class="mt-3 flex flex-wrap gap-2">
        <a href="mailto:<%= m.email %>?subject=<%= encodeURIComponent(`Re: ${m.subject || 'Your message'}`) %>" class="btn-dark btn-sm">Reply by email</a>
        <form action="/admin/messages/<%= m.id %>" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="action" value="<%= m.is_read ? 'unread' : 'read' %>"><button type="submit" class="btn-outline btn-sm">Mark as <%= m.is_read ? 'unread' : 'read' %></button></form>
        <form action="/admin/messages/<%= m.id %>" method="post" data-confirm="Delete this message?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="action" value="delete"><button type="submit" class="btn-outline btn-sm">Delete</button></form>
      </div>
    </li>
  <% }) %>
</ul>
<%- include('../partials/admin-pager', { page, hasMore, hrefFor: (n) => `/admin/messages?page=${n}` }) %>
